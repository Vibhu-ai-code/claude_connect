# IMAP (reading)
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=alice@example.com
IMAP_PASS=changeme
IMAP_USE_SSL=true
IMAP_TIMEOUT=30

# SMTP (sending)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=alice@example.com
SMTP_PASS=changeme
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=alice@example.com
SMTP_TIMEOUT=30

# Transport: stdio (default), http (streamable-http), or sse
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8765
# Paths to TLS cert + key. When both are set, the server speaks HTTPS.
MCP_SSL_CERT=/etc/ssl/certs/mcp-email.pem
MCP_SSL_KEY=/etc/ssl/private/mcp-email.key
# Optional bearer token. Clients must send: Authorization: Bearer <token>
MCP_AUTH_TOKEN=change-me-to-a-long-random-string
