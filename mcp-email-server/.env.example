# IMAP (reading)
IMAP_HOST=mail.example.com
IMAP_PORT=993
IMAP_USER=alice@example.com
IMAP_PASS=changeme
IMAP_USE_SSL=true
IMAP_TIMEOUT=30

# SMTP (sending)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_USER=alice@example.com
SMTP_PASS=changeme
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_FROM=alice@example.com
SMTP_TIMEOUT=30
